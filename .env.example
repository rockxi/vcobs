# Never expose these values with NEXT_PUBLIC_ prefix.
COUCHDB_URL=https://couchdb.rockxi.ru
COUCHDB_DATABASE=obsidian
COUCHDB_USERNAME=your-user
COUCHDB_PASSWORD=your-password

# Optional. Protects POST /api/v1/refresh when set.
VCOBS_REFRESH_TOKEN=choose-a-long-random-token

# Required for /admin. Store only the generated scrypt hash here, never the password.
# Docker Compose treats `$` as interpolation syntax inside env files, so each
# separator in the stored scrypt value must be escaped as `$$`.
# Generate with: node -e 'const c=require("crypto");const p=process.argv[1];const s=c.randomBytes(16);c.scrypt(p,s,64,{N:16384,r:8,p:1,maxmem:32*1024*1024},(e,h)=>console.log(`scrypt$$16384$$8$$1$$${s.toString("base64")}$$${h.toString("base64")}`))' 'your-long-password'
VCOBS_ADMIN_PASSWORD_HASH=scrypt$$16384$$8$$1$$BASE64_SALT$$BASE64_HASH
# Generate with: openssl rand -base64 48
VCOBS_ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
# Set true only behind a reverse proxy that overwrites X-Forwarded-For,
# X-Forwarded-Host and X-Forwarded-Proto from the actual client connection.
VCOBS_TRUST_PROXY_HEADERS=false
# Required when VCOBS_TRUST_PROXY_HEADERS=true. Exact public scheme and host only.
VCOBS_PUBLIC_ORIGIN=https://vcobs.example.com

# Remote desktops. Keep this server-side only: never use a NEXT_PUBLIC_ variable.
# Each device needs a distinct high-entropy token. The provisioning utility writes
# VCOBS_REMOTE_DEVICES_JSON safely into an existing .env.local; do not put a
# device ID or token in Git.

# Admin-only personal Codex chat. Generate an independent shared service secret
# with: openssl rand -hex 32. Never expose this with NEXT_PUBLIC_.
VCOBS_CHAT_SERVICE_SECRET=replace-with-an-independent-random-secret-at-least-32-characters
# Existing Asus private relay to the host-loopback Xray proxy. Codex can reach
# the Internet only through chat-egress; no public chat-service port is opened.
VCOBS_XRAY_HOST=172.31.0.1
VCOBS_XRAY_PORT=10809
