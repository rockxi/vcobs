  "narrative": {
    "overview": "vcobs keeps document reading and administrator tasks in the foreground. Existing page structures and theme choices remain intact. Obsidianite is the default; the theme registry defines six additional choices rather than one replacement identity.\n\nThe shared system uses restrained task surfaces, explicit text hierarchy and consistent semantic roles. The optional Liquid Chrome theme adds mirrored silver and black/blue reflections around calm content areas. The user approved the visual candidate and requested production publication on 2026-10-24.",
    "keyCharacteristics": [
      "Shared layout and behavior across theme choices.",
      "Theme-aware text, surfaces, controls and status colors.",
      "Solid reading and editing surfaces with decorative material at the edges."
    ],
    "rules": [
      {
        "name": "The Single Registry Rule",
        "body": "Define theme identities, base tokens and role overrides in `lib/themes.ts`; consume generated CSS properties throughout the application.",
        "section": "colors"
      },
      {
        "name": "The Reading Hierarchy Rule",
        "body": "Preserve readable body text and the existing heading hierarchy when adding a theme; material effects must not become a text treatment.",
        "section": "typography"
      },
      {
        "name": "The Content Surface Rule",
        "body": "Keep decorative reflections behind content and outside the image, remote-framebuffer and drawing data themselves.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve Obsidianite as the default and retain all existing theme choices.",
      "Do use the single registry and semantic roles across public and administrator pages.",
      "Do keep reading, editor and chat content legible under every theme.",
      "Do preserve focus, disabled, error and success states.",
      "Do keep Liquid Chrome optional and preserve the administrator's theme-availability settings."
    ],
    "donts": [
      "Don't change layouts or application functions to introduce a theme.",
      "Don't replace Liquid Glass with Liquid Chrome.",
      "Don't recolor uploaded images, remote pixels or drawing objects.",
      "Don't place animated glare over text or intercept input with decorative rendering.",
      "Don't claim measured GPU performance from configured renderer limits."
    ]
  }
}
